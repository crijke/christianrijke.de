---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} noindex>
  <article lang="de" class="column pt-12">
    <h1 class="text-xl font-semibold">{title}</h1>
    <div class="mt-6 space-y-4 [&_a]:link [&_h2]:pt-4 [&_h2]:font-semibold">
      <slot />
    </div>
  </article>
</BaseLayout>
