---
import { profile } from '../content/profile';
import { ThemeToggle } from './ThemeToggle';
---

<footer class="column mt-24 pb-12 text-sm text-muted">
  <div class="flex items-start justify-between gap-6 border-t border-line pt-6">
    <div class="space-y-1">
      <ul aria-label="Legal" class="flex flex-wrap gap-x-4 gap-y-1">
        <li>
          © {new Date().getFullYear()} {profile.name}
        </li>
        <li>
          <a href="/imprint" class="hover:text-ink">
            Imprint
          </a>
        </li>
        <li>
          <a href="/privacy" class="hover:text-ink">
            Privacy
          </a>
        </li>
        <li>
          <a href={profile.source} rel="noopener" class="hover:text-ink">
            Source
          </a>
        </li>
      </ul>
      <p>
        Photo by{' '}
        <a href={profile.portraitCredit.href} rel="noopener" class="hover:text-ink">
          {profile.portraitCredit.label}
        </a>
      </p>
    </div>
    <ThemeToggle client:load />
  </div>
</footer>
