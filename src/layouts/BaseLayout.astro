---
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { SiteFooter } from '../components/SiteFooter';
import SiteHeader from '../components/SiteHeader.astro';
import { profile } from '../content/profile';
import { themeInitScript } from '../lib/theme';
import { publicPath } from '../lib/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Legal pages shouldn't show up in search results. */
  noindex?: boolean;
}

const { title, description = profile.description, noindex = false } = Astro.props;
const path = publicPath(Astro.url.pathname);
const isHome = path === '/';
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(path, Astro.site);

const ogImage = await getImage({
  src: portrait,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: profile.url,
  email: `mailto:${profile.email}`,
  image: new URL(ogImage.src, Astro.site).href,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'ETH Zürich' },
  sameAs: Object.values(profile.links).map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1518" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Portrait of ${profile.name}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    <script is:inline set:html={themeInitScript} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <SiteHeader basePath={isHome ? '' : '/'} />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
