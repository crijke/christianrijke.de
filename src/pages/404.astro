---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container-page py-24 sm:py-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">This page doesn’t exist.</h1>
    <p class="mt-6 text-lg text-muted">
      It may have moved when this site was rebuilt.{' '}
      <a href="/" class="link">
        Go to the home page
      </a>
    </p>
  </section>
</BaseLayout>
