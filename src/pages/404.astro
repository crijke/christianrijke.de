---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="column pt-12">
    <h1 class="text-xl font-semibold">Page not found</h1>
    <p class="mt-4 text-muted">
      This page doesn’t exist. It may have moved when the site was rebuilt.{' '}
      <a href="/" class="link text-ink">
        Go to the home page
      </a>
      .
    </p>
  </section>
</BaseLayout>
